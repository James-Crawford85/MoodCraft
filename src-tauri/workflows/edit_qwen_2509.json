{
  "1": { "class_type": "UNETLoader", "_meta": { "title": "Load Qwen-Image-Edit 2509" },
         "inputs": { "unet_name": "qwen_image_edit_2509_int8_convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader",
         "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "qwen_image_vae.safetensors" } },
  "4": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
  "5": { "class_type": "FluxKontextImageScale", "inputs": { "image": ["4", 0] } },
  "6": { "class_type": "TextEncodeQwenImageEditPlus", "_meta": { "title": "Positive" },
         "inputs": { "clip": ["2", 0], "prompt": "{{prompt}}", "vae": ["3", 0], "image1": ["5", 0] } },
  "7": { "class_type": "TextEncodeQwenImageEditPlus", "_meta": { "title": "Negative" },
         "inputs": { "clip": ["2", 0], "prompt": "{{negative}}", "vae": ["3", 0], "image1": ["5", 0] } },
  "8": { "class_type": "VAEEncode", "inputs": { "pixels": ["5", 0], "vae": ["3", 0] } },
  "9": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.0 } },
  "10": { "class_type": "CFGNorm", "inputs": { "model": ["9", 0], "strength": 1.0 } },
  "11": { "class_type": "KSampler",
          "inputs": { "model": ["10", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["8", 0],
                      "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
                      "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
  "12": { "class_type": "VAEDecode", "inputs": { "samples": ["11", 0], "vae": ["3", 0] } },
  "13": { "class_type": "SaveImage", "inputs": { "images": ["12", 0], "filename_prefix": "{{prefix}}/edit" } }
}
