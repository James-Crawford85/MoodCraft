{
  "1": { "class_type": "UNETLoader", "_meta": { "title": "Load diffusion model" },
         "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "_meta": { "title": "Load text encoder" },
         "inputs": { "clip_name": "{{clip}}", "type": "{{clip_type}}", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
  "4": { "class_type": "CLIPTextEncode", "_meta": { "title": "Positive" },
         "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
  "5": { "class_type": "CLIPTextEncode", "_meta": { "title": "Negative" },
         "inputs": { "text": "{{negative}}", "clip": ["2", 0] } },
  "10": { "class_type": "LoadImage", "_meta": { "title": "Source image" }, "inputs": { "image": "{{image}}" } },
  "12": { "class_type": "ImageScaleToTotalPixels",
          "inputs": { "image": ["10", 0], "upscale_method": "area", "megapixels": "{{megapixels}}", "resolution_steps": 16 } },
  "20": { "class_type": "LoadImage", "_meta": { "title": "Mask (white = repaint)" }, "inputs": { "image": "{{mask}}" } },
  "21": { "class_type": "ImageScaleToTotalPixels",
          "inputs": { "image": ["20", 0], "upscale_method": "area", "megapixels": "{{megapixels}}", "resolution_steps": 16 } },
  "22": { "class_type": "ImageToMask", "inputs": { "image": ["21", 0], "channel": "red" } },
  "11": { "class_type": "ReferenceMultiLatent", "_meta": { "title": "Source as reference (context for the instruction)" },
          "inputs": { "positive": ["4", 0], "negative": ["5", 0], "vae": ["3", 0],
                      "resolution": "resize", "resolution.megapixels": "{{megapixels}}",
                      "images.image0": ["12", 0] } },
  "13": { "class_type": "VAEEncode", "inputs": { "pixels": ["12", 0], "vae": ["3", 0] } },
  "14": { "class_type": "SetLatentNoiseMask", "inputs": { "samples": ["13", 0], "mask": ["22", 0] } },
  "15": { "class_type": "DifferentialDiffusion", "inputs": { "model": ["1", 0], "strength": 1.0 } },
  "7": { "class_type": "KSampler",
         "inputs": { "model": ["15", 0], "positive": ["11", 0], "negative": ["11", 1], "latent_image": ["14", 0],
                     "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
                     "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "denoise": "{{denoise}}" } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["7", 0], "vae": ["3", 0] } },
  "16": { "class_type": "ImageCompositeMasked", "_meta": { "title": "Keep everything outside the mask" },
          "inputs": { "destination": ["12", 0], "source": ["8", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["22", 0] } },
  "9": { "class_type": "SaveImage", "inputs": { "images": ["16", 0], "filename_prefix": "{{prefix}}/inpaint" } }
}
