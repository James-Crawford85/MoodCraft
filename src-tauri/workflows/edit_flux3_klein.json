{
  "1": { "class_type": "UNETLoader", "_meta": { "title": "Load Flux3 Klein" },
         "inputs": { "unet_name": "flux3-image-klein-base-int8-convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "_meta": { "title": "Load Qwen3-VL 4B (flux3)" },
         "inputs": { "clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "flux3", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "4": { "class_type": "CLIPTextEncode", "_meta": { "title": "Positive" },
         "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
  "5": { "class_type": "CLIPTextEncode", "_meta": { "title": "Negative" },
         "inputs": { "text": "{{negative}}", "clip": ["2", 0] } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
  "11": { "class_type": "ReferenceMultiLatent", "_meta": { "title": "Reference image → conditioning + latent" },
          "inputs": { "positive": ["4", 0], "negative": ["5", 0], "vae": ["3", 0],
                      "resolution": "resize", "resolution.megapixels": "{{megapixels}}",
                      "images.image0": ["10", 0] } },
  "7": { "class_type": "KSampler",
         "inputs": { "model": ["1", 0], "positive": ["11", 0], "negative": ["11", 1], "latent_image": ["11", 2],
                     "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
                     "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["7", 0], "vae": ["3", 0] } },
  "9": { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "{{prefix}}/edit" } }
}
