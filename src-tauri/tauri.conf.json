{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoodCraft",
  "version": "0.1.0",
  "identifier": "com.sunsh.moodcraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoodCraft",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "publisher": "James-Crawford85",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
